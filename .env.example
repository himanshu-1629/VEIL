# ==============================================================================
# VEIL Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or configure these variables in your Cloud PaaS
# (Render / Railway / Fly.io / Docker Environment Settings).
#
# NO CREDENTIALS SHOULD EVER BE HARDCODED IN THE JAVA SOURCE CODE.
# ==============================================================================

# Database Driver class
VEIL_DB_DRIVER=oracle.jdbc.OracleDriver

# Oracle JDBC URL format:
# Local/Docker:  jdbc:oracle:thin:@localhost:1521/FREEPDB1
# Online/Cloud:  jdbc:oracle:thin:@<REMOTE_HOST>:<REMOTE_PORT>/<SERVICE_NAME>
# Example Cloud: jdbc:oracle:thin:@db.veil-cyber.org:1521/FREEPDB1
VEIL_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

# Oracle Database User Credentials
VEIL_DB_USER=system
VEIL_DB_PASSWORD=oracle123

# HTTP Port (Dynamic on Cloud platforms like Render / Railway)
PORT=8080
